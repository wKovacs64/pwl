{
  "name": "pwl",
  "version": "0.0.0-semantically-released",
  "description": "Static web application to reveal character types in a password",
  "type": "module",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wKovacs64/pwl.git"
  },
  "bugs": {
    "url": "https://github.com/wKovacs64/pwl/issues"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "preview": "vite --host 127.0.0.1 preview",
    "test": "npm run test:e2e:open",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:run": "cross-env CI=true playwright test",
    "typecheck": "tsc"
  },
  "private": true,
  "dependencies": {
    "@axe-core/playwright": "4.10.1",
    "@babel/core": "7.27.1",
    "@babel/parser": "7.27.2",
    "@babel/plugin-syntax-jsx": "7.27.1",
    "@fontsource/nunito": "5.2.5",
    "@fontsource/source-sans-3": "5.2.7",
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "4.1.7",
    "@types/lodash": "4.17.17",
    "@types/ms": "2.1.0",
    "@types/node": "22.15.21",
    "@types/node-fetch": "2.6.12",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react-swc": "3.9.0",
    "@wkovacs64/eslint-config": "7.5.2",
    "@wkovacs64/prettier-config": "4.1.1",
    "@xstate/react": "5.0.4",
    "axe-core": "4.10.3",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "eslint": "9.27.0",
    "git-current-commit": "1.1.0",
    "hibp": "15.0.1",
    "history": "5.3.0",
    "lodash": "4.17.21",
    "memoize-one": "6.0.0",
    "mobile-detect": "1.4.5",
    "ms": "2.1.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "prop-types": "15.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "5.5.0",
    "react-router": "7.6.0",
    "semantic-release": "24.2.4",
    "tailwindcss": "4.1.7",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "workbox-build": "7.3.0",
    "workbox-window": "7.3.0",
    "xstate": "5.19.3"
  }
}
